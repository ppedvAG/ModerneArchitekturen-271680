@model EasyBib.WebMvc.Models.MediaItemViewModel

@{
    ViewData["Title"] = "Neues Medium";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-action="Index"
           class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i>
            Zurück zu den Medien
        </a>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="mb-4">
                <h1 class="fw-bold">Neues Medium</h1>
                <p class="text-muted">
                    Erfasse ein neues Medium für die Bibliothek.
                </p>
            </div>

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <div class="mb-4">
                            <label asp-for="EAN"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="EAN"
                                   class="form-control form-control-lg"
                                   placeholder="z. B. 978-3-16-148410-0"
                                   autofocus />

                            <div class="form-text">
                                Gib die EAN des Mediums ein.
                            </div>

                            <span asp-validation-for="EAN"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-light">
                                Abbrechen
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>
                                Medium anlegen
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}